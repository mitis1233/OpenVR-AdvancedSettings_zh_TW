      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "targets": [
        "AdvancedSettings"
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "targets": [
        "AdvancedSettings"
      ]
    },
    {
      "name": "windows-release-package",
      "displayName": "Windows x64 Release Package",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "targets": [
        "AdvancedSettingsPackage"
      ]
    }
  ]
}