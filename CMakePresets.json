{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 - MSVC 2022 / Qt 6.8.3",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64",
      "installDir": "${sourceDir}/out/install/windows-x64",
      "cacheVariables": {
        "Qt6_DIR": {
          "type": "PATH",
          "value": "C:/Qt/6.8.3/msvc2022_64/lib/cmake/Qt6"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
